# Environment Configuration for Credit Risk Scoring
# Copy this file to .env and customize values

# Application
APP_ENV=production
LOG_LEVEL=INFO
PYTHONPATH=/app/src

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model
MODEL_PATH=/app/models/best_model.pkl
PREPROCESSOR_PATH=/app/models/preprocessor.pkl
DECISION_THRESHOLD=0.5

# Data
RAW_DATA_PATH=/app/data/raw/german_credit.data
PROCESSED_DATA_PATH=/app/data/processed/credit_risk_processed.parquet

# Training
TRAIN_TEST_SPLIT=0.2
RANDOM_STATE=42
CV_FOLDS=5
HYPERPARAMETER_SEARCH_ITER=20

# Monitoring
PROMETHEUS_ENABLED=false
METRICS_PORT=9090

# Database (if using)
# DATABASE_URL=postgresql://user:pass@host:5432/credit_risk

# Security
# API_KEY=your-secret-api-key
# JWT_SECRET=your-jwt-secret

# External Services
# MLFLOW_TRACKING_URI=http://mlflow:5000
# WANDB_API_KEY=your-wandb-key